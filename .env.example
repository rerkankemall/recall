# --- Anthropic ---
# Your Claude API key. NEVER expose this in client-side code — it is only
# ever read inside app/api/extract/route.ts, which runs on the server.
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase ---
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # safe to expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # server-only, never expose

# --- Daily digest email (optional, skip if you don't want reminder emails) ---
# From resend.com -> API Keys
RESEND_API_KEY=re_...
# Must be from a domain you've verified in Resend, or leave as the Resend
# sandbox address below for testing (only delivers to your own Resend account email)
RESEND_FROM_EMAIL=Afterword <onboarding@resend.dev>
# A long random string you make up yourself. The external hourly scheduler
# (e.g. cron-job.org) must send this as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- YouTube transcript fetching (optional, skip to disable pasting YouTube links) ---
# From supadata.ai -> API Keys. Free tier: 100 transcripts/month.
SUPADATA_API_KEY=

# --- Stripe (optional, add when you're ready to charge) ---
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...                      # the subscription price you create in Stripe
NEXT_PUBLIC_APP_URL=http://localhost:3000       # used for Stripe redirect URLs
